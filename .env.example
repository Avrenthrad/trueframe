# ── Site ────────────────────────────────────────────────────────────
# Canonical public URL (no trailing slash). Used for RSS, sitemaps, OG, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://trueframe.example

# ── Supabase (Postgres + Storage) ───────────────────────────────────
# Leave blank to run on the built-in seed data (read-only demo + in-memory API store).
SUPABASE_URL=
# Server-only. NEVER expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket for mirrored hero images (created by 001_init.sql).
SUPABASE_STORAGE_BUCKET=hero-images

# ── Publishing API (Grok Bot → /api/publish) ────────────────────────
# Generate with: openssl rand -hex 32
PUBLISH_API_KEY=

# ── External intake (/api/intake) ───────────────────────────────────
# Shared secret for X-Intake-Secret header OR HMAC-SHA256 signing (X-Intake-Signature).
INTAKE_SECRET=
# Comma-separated source IDs (X-Intake-Source) allowed to publish directly.
# Everyone else lands in draft for editorial review.
INTAKE_TRUSTED_SOURCES=

# ── Cron (/api/cron/publish-scheduled) ──────────────────────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=
